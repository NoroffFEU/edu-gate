.primary-button {
  background-color: #4caf50;
  color: #ffffff;
  font-family: "Poppins", "sans-serif";
  font-size: larger;
  font-weight: 500;
  letter-spacing: 0.05em;
  border: 2px solid #4caf50;
  border-radius: 6px;
  padding: 10px 20px;
  cursor: pointer;
}
.primary-button:hover {
  background-color: #388e3c;
  border: 2px solid #388e3c;
}
.secondary-button {
  border: 2px solid #2196f3;
  color: #2196f3;
  font-family: "Poppins", "sans-serif";
  font-size: larger;
  font-weight: 500;
